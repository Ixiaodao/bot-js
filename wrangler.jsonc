{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bot-js",
	"main": "src/index.js",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1

	},
	"compatibility_flags": [
		"nodejs_compat"
	]
